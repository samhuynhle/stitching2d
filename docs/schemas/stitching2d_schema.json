{
  "$defs": {
    "Attachment": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/AttachmentType"
        },
        "position": {
          "$ref": "#/$defs/Point2D",
          "description": "Anchor point on pattern piece"
        },
        "length": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Length in project units (e.g. for webbing/zippers/velcro)",
          "title": "Length"
        },
        "width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Width in project units (e.g. 1.0 in webbing)",
          "title": "Width"
        },
        "angle_deg": {
          "default": 0.0,
          "description": "Orientation angle in degrees",
          "title": "Angle Deg",
          "type": "number"
        },
        "layer": {
          "default": "exterior",
          "description": "exterior, interior, or sandwiched",
          "title": "Layer",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "position"
      ],
      "title": "Attachment",
      "type": "object"
    },
    "AttachmentType": {
      "enum": [
        "webbing",
        "zipper",
        "velcro",
        "snap_button",
        "grommet",
        "d_ring",
        "buckle",
        "elastic",
        "interfacing",
        "bartack",
        "box_x",
        "label"
      ],
      "title": "AttachmentType",
      "type": "string"
    },
    "Edge": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "edge_type": {
          "$ref": "#/$defs/EdgeType",
          "default": "line"
        },
        "start": {
          "$ref": "#/$defs/Point2D"
        },
        "end": {
          "$ref": "#/$defs/Point2D"
        },
        "control_points": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Point2D"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Points"
        },
        "seam_allowance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom SA for this edge. If None, inherits piece default.",
          "title": "Seam Allowance"
        },
        "seam_type": {
          "$ref": "#/$defs/SeamType",
          "default": "standard"
        },
        "hem_depth": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Additional fold depth if hem_fold",
          "title": "Hem Depth"
        },
        "paired_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target piece_id:edge_id to validate join consistency",
          "title": "Paired To"
        },
        "notches": {
          "description": "Arc distances along edge from start where notches are cut",
          "items": {
            "type": "number"
          },
          "title": "Notches",
          "type": "array"
        }
      },
      "required": [
        "id",
        "start",
        "end"
      ],
      "title": "Edge",
      "type": "object"
    },
    "EdgeType": {
      "enum": [
        "line",
        "bezier",
        "arc"
      ],
      "title": "EdgeType",
      "type": "string"
    },
    "FabricMaterial": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "description": "e.g. 500D Cordura, X-Pac VX21, 210D Ripstop Nylon, Mesh",
          "title": "Type",
          "type": "string"
        },
        "bolt_width": {
          "default": 60.0,
          "description": "Usable roll width in project units (e.g. 60.0 in)",
          "exclusiveMinimum": 0.0,
          "title": "Bolt Width",
          "type": "number"
        },
        "cost_per_yard": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Per Yard"
        },
        "weight_oz_yd2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Oz Yd2"
        },
        "directional_nap": {
          "default": false,
          "description": "If True, all pieces must align in the same 0-degree grain direction",
          "title": "Directional Nap",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "type"
      ],
      "title": "FabricMaterial",
      "type": "object"
    },
    "Grainline": {
      "properties": {
        "start_point": {
          "$ref": "#/$defs/Point2D"
        },
        "end_point": {
          "$ref": "#/$defs/Point2D"
        },
        "angle_deg": {
          "default": 0.0,
          "description": "Angle in degrees (0=straight grain, 90=cross, 45=bias)",
          "title": "Angle Deg",
          "type": "number"
        },
        "directional": {
          "default": false,
          "description": "If True, fabric has directional nap/pile and cannot be rotated 180 deg",
          "title": "Directional",
          "type": "boolean"
        }
      },
      "title": "Grainline",
      "type": "object"
    },
    "HardwareItem": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "description": "e.g. Side Release Buckle 1in, YKK #5 Slider, Cordlock",
          "title": "Type",
          "type": "string"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "name",
        "type"
      ],
      "title": "HardwareItem",
      "type": "object"
    },
    "PatternPiece": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "default": "main_body",
          "description": "main_body, lining, pocket, gusset, trim, reinforcement",
          "title": "Category",
          "type": "string"
        },
        "fabric_id": {
          "title": "Fabric Id",
          "type": "string"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "mirror": {
          "default": false,
          "description": "Cut 1 normal + 1 mirrored if quantity > 1",
          "title": "Mirror",
          "type": "boolean"
        },
        "default_seam_allowance": {
          "default": 0.5,
          "description": "Default SA in project units",
          "minimum": 0.0,
          "title": "Default Seam Allowance",
          "type": "number"
        },
        "vertices": {
          "description": "Ordered closed perimeter vertices",
          "items": {
            "$ref": "#/$defs/Point2D"
          },
          "minItems": 3,
          "title": "Vertices",
          "type": "array"
        },
        "edges": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Edge"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Detailed edge definitions. If omitted, generated from vertices.",
          "title": "Edges"
        },
        "grainline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Grainline"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "title": "Attachments",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "name",
        "fabric_id",
        "vertices"
      ],
      "title": "PatternPiece",
      "type": "object"
    },
    "Point2D": {
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point2D",
      "type": "object"
    },
    "SeamType": {
      "enum": [
        "standard",
        "flat_felled",
        "french",
        "hem_fold",
        "zipper",
        "bias_bound",
        "raw_edge",
        "overlock"
      ],
      "title": "SeamType",
      "type": "string"
    },
    "Unit": {
      "enum": [
        "in",
        "mm",
        "cm"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "version": {
      "default": "1.0.0",
      "title": "Version",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "units": {
      "$ref": "#/$defs/Unit",
      "default": "in"
    },
    "fabrics": {
      "items": {
        "$ref": "#/$defs/FabricMaterial"
      },
      "title": "Fabrics",
      "type": "array"
    },
    "pieces": {
      "items": {
        "$ref": "#/$defs/PatternPiece"
      },
      "title": "Pieces",
      "type": "array"
    },
    "hardware": {
      "items": {
        "$ref": "#/$defs/HardwareItem"
      },
      "title": "Hardware",
      "type": "array"
    },
    "sewing_notes": {
      "items": {
        "type": "string"
      },
      "title": "Sewing Notes",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "ProjectPattern",
  "type": "object"
}